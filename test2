from flask import Flask, request, render_template_string
from openai import OpenAI
NVIDIA_API_KEY = "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"

app = Flask(__name__)

client = OpenAI(
    base_url="https://integrate.api.nvidia.com/v1",
    api_key=NVIDIA_API_KEY
)

PAGE = """
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Mon IA</title>

    <style>
        body {
            font-family: Arial;
            max-width: 800px;
            margin: 50px auto;
            padding: 20px;
        }

        textarea {
            width: 100%;
            height: 120px;
            font-size: 16px;
            padding: 10px;
            box-sizing: border-box;
        }

        button {
            margin-top: 10px;
            padding: 12px 25px;
            font-size: 16px;
        }

        .reponse {
            margin-top: 25px;
            padding: 20px;
            background: #eeeeee;
            white-space: pre-wrap;
        }
    </style>
</head>

<body>

<h1>🤖 Mon IA NVIDIA</h1>

<form method="POST">

<textarea
    name="message"
    placeholder="Écris ton message..."
    required
></textarea>

<br>

<button type="submit">Envoyer</button>

</form>

{% if reponse %}
<div class="reponse">
<strong>IA :</strong><br><br>
{{ reponse }}
</div>
{% endif %}

</body>
</html>
"""

@app.route("/", methods=["GET", "POST"])
def accueil():

    reponse = ""

    if request.method == "POST":

        message = request.form["message"]

        try:

            resultat = client.chat.completions.create(
                model="openai/gpt-oss-120b",
                messages=[
                    {
                        "role": "user",
                        "content": message
                    }
                ]
            )

            reponse = resultat.choices[0].message.content

        except Exception as erreur:

            reponse = "Erreur NVIDIA : " + str(erreur)

    return render_template_string(PAGE, reponse=reponse)


app.run(host="0.0.0.0", port=5000)